{
  "$schema": "https://tr.designtokens.org/format/",
  "meta": {
    "name": "Euros Ponto & Vale Alimentação (V4) Design System",
    "version": "4.2.0",
    "extractedFrom": "Dark Mode (:root) -> Mapped to Light Mode ([data-theme='light'])"
  },
  "color": {
    "brand": {
      "primary": { "dark": "#4015B8", "light": "#4015B8", "description": "Electric Indigo brand anchor" },
      "primaryHover": { "dark": "#4E1CDB", "light": "#331094", "description": "Primary interactive hover" },
      "primaryLight": { "dark": "#5B28EA", "light": "#6366F1", "description": "Lighter brand accent" },
      "cyan": { "dark": "#00E5FF", "light": "#1D4ED8", "description": "High-visibility data & interactive accent (WCAG AA compliant in light mode)" },
      "blueBright": { "dark": "#38BDF8", "light": "#0369A1", "description": "Secondary sky/ocean highlight" },
      "blueSoft": { "dark": "#ADD8E6", "light": "#475569", "description": "Soft label and control foreground" }
    },
    "surface": {
      "bgBase": { "dark": "#0F0F11", "light": "#F4F6F9", "description": "Root application canvas" },
      "bgDark": { "dark": "#15131B", "light": "#EEF1F6", "description": "Secondary recessed surface, toolbars, footers" },
      "bgPanel": { "dark": "#1B1824", "light": "#E2E8F0", "description": "Navigation track & structural containers" },
      "bgCard": { "dark": "#282433", "light": "#FFFFFF", "description": "Primary elevated cards, modals, sticky columns" },
      "bgSurface": { "dark": "#2F2D33", "light": "#F8FAFC", "description": "Form controls, table headers, subtle wells" },
      "bgElevated": { "dark": "#1C1827", "light": "#F1F5F9", "description": "Modal summary banners and inner callout boxes" }
    },
    "border": {
      "default": { "dark": "#342A52", "light": "#CBD5E1", "description": "1px structural hairline" },
      "bright": { "dark": "#422985", "light": "#94A3B8", "description": "Emphasized container & sticky divider border" },
      "focus": { "dark": "#00E5FF", "light": "#4015B8", "description": "Keyboard focus ring & active input border" }
    },
    "text": {
      "main": { "dark": "#F3F4F6", "light": "#0F172A", "contrastLight": "16.8:1" },
      "sub": { "dark": "#B8B2C7", "light": "#334155", "contrastLight": "9.8:1" },
      "muted": { "dark": "#7E7790", "light": "#64748B", "contrastLight": "4.76:1" }
    },
    "status": {
      "ok": {
        "bg": { "dark": "rgba(0, 229, 255, 0.08)", "light": "#ECFDF5" },
        "border": { "dark": "rgba(0, 229, 255, 0.35)", "light": "#6EE7B7" },
        "text": { "dark": "#00E5FF", "light": "#065F46", "contrastLight": "8.2:1" }
      },
      "falta": {
        "bg": { "dark": "rgba(239, 68, 68, 0.22)", "light": "#FEE2E2" },
        "border": { "dark": "#EF4444", "light": "#EF4444" },
        "text": { "dark": "#FCA5A5", "light": "#991B1B", "contrastLight": "8.1:1" }
      },
      "half": {
        "bg": { "dark": "rgba(244, 63, 94, 0.20)", "light": "#FFE4E6" },
        "border": { "dark": "#F43F5E", "light": "#F43F5E" },
        "text": { "dark": "#FDA4AF", "light": "#9F1239", "contrastLight": "7.8:1" }
      },
      "atraso": {
        "bg": { "dark": "rgba(245, 158, 11, 0.20)", "light": "#FEF3C7" },
        "border": { "dark": "#F59E0B", "light": "#F59E0B" },
        "text": { "dark": "#FDE68A", "light": "#92400E", "contrastLight": "7.4:1" }
      },
      "atestado": {
        "bg": { "dark": "rgba(66, 41, 133, 0.55)", "light": "#F3E8FF" },
        "border": { "dark": "#5A3AA6", "light": "#C084FC" },
        "text": { "dark": "#E2DCF7", "light": "#581C87", "contrastLight": "8.9:1" }
      },
      "ferias": {
        "bg": { "dark": "#231B38", "light": "#F0F9FF" },
        "border": { "dark": "#342A52", "light": "#7DD3FC" },
        "text": { "dark": "#7E7790", "light": "#0C4A6E", "contrastLight": "8.6:1" }
      },
      "feriado": {
        "bg": { "dark": "rgba(64, 21, 184, 0.25)", "light": "#EEF2FF" },
        "border": { "dark": "#4015B8", "light": "#818CF8" },
        "text": { "dark": "#38BDF8", "light": "#312E81", "contrastLight": "9.5:1" }
      },
      "sunday": {
        "bg": { "dark": "#1B1822", "light": "#E2E8F0" },
        "text": { "dark": "#675F79", "light": "#334155", "contrastLight": "7.8:1" }
      }
    }
  },
  "radius": {
    "sm": "4px",
    "md": "8px",
    "lg": "12px"
  },
  "shadow": {
    "dark": {
      "glow": "0 0 15px rgba(0, 229, 255, 0.18)",
      "purple": "0 4px 20px rgba(64, 21, 184, 0.35)",
      "card": "0 4px 14px rgba(0, 0, 0, 0.45)"
    },
    "light": {
      "glow": "0 2px 8px rgba(64, 21, 184, 0.12)",
      "purple": "0 8px 24px rgba(15, 23, 42, 0.08)",
      "card": "0 1px 3px rgba(15, 23, 42, 0.06), 0 1px 2px rgba(15, 23, 42, 0.04)"
    }
  },
  "typography": {
    "fontSans": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif",
    "fontMono": "'Cascadia Code', 'Fira Code', 'Consolas', 'Courier New', monospace"
  }
}
